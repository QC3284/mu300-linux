#!/bin/sh
# 快速状态(不走 AT,纯 sysfs/命令,~0.2 秒):流量速率、计数、在线时长、温度、WiFi、客户端数
# 目的:让页面 5 秒一次刷新,而不是等那条要 20 秒的 AT 采集
WAN=sipa_eth0; LAN=br-lan
r1=$(cat /sys/class/net/$WAN/statistics/rx_bytes 2>/dev/null || echo 0)
t1=$(cat /sys/class/net/$WAN/statistics/tx_bytes 2>/dev/null || echo 0)
sleep 1
r2=$(cat /sys/class/net/$WAN/statistics/rx_bytes 2>/dev/null || echo 0)
t2=$(cat /sys/class/net/$WAN/statistics/tx_bytes 2>/dev/null || echo 0)
rxr=$((r2 - r1)); txr=$((t2 - t1))
[ $rxr -lt 0 ] && rxr=0; [ $txr -lt 0 ] && txr=0
up=$(cut -d. -f1 /proc/uptime 2>/dev/null)
temp=$(awk '{printf "%.1f", $1/1000}' /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
ssid=$(uci -q get wireless.@wifi-iface[0].ssid)
clients=$(iw dev wlan0 station dump 2>/dev/null | grep -c Station)
v4=$(ip -4 -br addr show $WAN 2>/dev/null | awk '{print $3}')
v6=$(ip -6 addr show $WAN 2>/dev/null | grep 'scope global' | awk '{print $2}' | head -1)
lan4=$(ip -4 -br addr show $LAN 2>/dev/null | awk '{print $3}')
lan6=$(ip -6 addr show $LAN 2>/dev/null | awk '/scope global/ {print $2}' | grep -v '^fd' | head -1)
fbytes() { n=${1:-0}; u=0; while [ $n -ge 1024 ] && [ $u -lt 4 ]; do n=$((n/1024)); u=$((u+1)); done; echo $n; }
printf '{\n'
printf '  "updated": %s,\n' "$(date +%s)"
printf '  "rx_bytes": %s, "tx_bytes": %s,\n' "$r2" "$t2"
printf '  "rx_rate": %s, "tx_rate": %s,\n' "$rxr" "$txr"
printf '  "uptime": %s, "temperature": "%s",\n' "${up:-0}" "$temp"
printf '  "ssid": "%s", "clients": %s,\n' "$ssid" "${clients:-0}"
printf '  "wan4": "%s", "wan6": "%s",\n' "$v4" "$v6"
printf '  "lan4": "%s", "lan6": "%s"\n' "$lan4" "$lan6"
printf '}\n'