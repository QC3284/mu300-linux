#!/bin/sh
# 采集无线/有线客户端的原始数据(供 mu300-clients-collect.uc 解析)
mkdir -p /tmp
# ① 无线客户端(sprd 驱动的 station dump 常返回空 ✗,仅作参考)
iw dev wlan0 station dump > /tmp/mu300-wifi-stations.raw 2>/dev/null
# ② 邻居表(IP/MAC/在线状态)
ip neigh show dev br-lan > /tmp/mu300-neigh.raw 2>/dev/null
# ③ DHCP 租约
cp /tmp/dhcp.leases /tmp/mu300-leases.raw 2>/dev/null
# ④ ★ 网桥端口映射(内核的表最可靠)★
#     /sys/class/net/br-lan/brif/<iface>/port_no → 端口号
: > /tmp/mu300-brports.raw
for d in /sys/class/net/br-lan/brif/*; do
  [ -e "$d" ] || continue
  ifn=$(basename "$d")
  pn=$(cat "$d/port_no" 2>/dev/null)
  [ -n "$pn" ] && echo "$pn $ifn" >> /tmp/mu300-brports.raw
done
# ⑤ ★ 网桥 FDB:每个 MAC 在哪个端口 ★
brctl showmacs br-lan > /tmp/mu300-brfdb.raw 2>/dev/null
# ⑥ 无线信息(信号强度,sprd 可能没有)
for m in $(brctl showmacs br-lan 2>/dev/null | awk 'NR>1 && $3=="no" {print $2}' | sort -u); do
  s=$(iw dev wlan0 station get "$m" 2>/dev/null | sed -n 's/.*signal: *\([-0-9]*\).*/\1/p' | head -1)
  [ -n "$s" ] && echo "$m $s" >> /tmp/mu300-wifi-signal.raw
done
ucode /usr/bin/mu300-clients-collect.uc