#!/bin/sh
# 服务小区 + 邻区(展锐工程模式;查询码来自 RIL 反汇编)
#   AT+SPENGMD=0,14,1 = 服务小区;AT+SPENGMD=0,14,2 = 邻区(最多 4 个)
#   ⚠ 格式细节:分组分隔符是单个 '-',而负数是 '--' 开头(分隔符+负号)
#     所以先把 '--' 换成占位符再切分,否则会被减号切碎 ✗
#   数值:RSPR/RSRQ/SINR 除以 100(整数上报)
export PATH="$PATH:/opt/mu300/bin:/opt/mu300/busybox-bin"
at() { mu300-at -t 12 "$1" 2>/dev/null | grep -v '^AT' | grep -v '^OK' | grep -v '^$' | head -1; }
NEG='QQNEGQQ'
# 分组规则(踩了三次才理清):数据长这样
#   1,0-422910,0-505,0--10050,0--1262,0-...-312,0-...-17--76-0-...
#   ',' 分隔组内的值;'-' 是【分组符】;要是第一个值是负数,就会出现 '--'(分组符 + 负号)
#   所以:先把【分组符】替换成 '|'(不会出现在数据里),再按 '|' 切 —— 负号原样保留 ✓
# shellcheck disable=SC2016
grp() { printf '%s' "$1" | sed -e 's/\([0-9]\)--/\1|-/g' -e 's/\([0-9]\)-/\1|/g' | cut -d'|' -f$2; }
f()   { printf '%s' "$1" | cut -d',' -f$2; }
d100(){ [ -z "$1" ] && { echo ''; return; }; awk -v v="$1" 'BEGIN{printf "%.1f", v/100}'; }
band_of_arfcn() {
  a=$1
  case "$a" in ''|0|*[!0-9]*) echo '?'; return;; esac
  if   [ $a -ge 422000 ] && [ $a -le 440000 ]; then echo n1
  elif [ $a -ge 173800 ] && [ $a -le 178800 ]; then echo n5
  elif [ $a -ge 185000 ] && [ $a -le 192000 ]; then echo n8
  elif [ $a -ge 151600 ] && [ $a -le 160600 ]; then echo n28
  elif [ $a -ge 499200 ] && [ $a -le 537999 ]; then echo n41
  elif [ $a -ge 620000 ] && [ $a -le 653333 ]; then echo n78
  else echo '?'; fi
}
srv=$(at 'AT+SPENGMD=0,14,1')
s_arfcn=$(f "$(grp "$srv" 2)" 1)
s_pci=$(  f "$(grp "$srv" 3)" 1)
s_rsrp=$( f "$(grp "$srv" 4)" 1)
s_rsrq=$( f "$(grp "$srv" 5)" 1)
s_sinr=$( f "$(grp "$srv" 6)" 1)
s_band=$(band_of_arfcn "$s_arfcn")
nbr=$(at 'AT+SPENGMD=0,14,2')
n_arfcn=$(grp "$nbr" 2); n_pci=$(grp "$nbr" 3); n_rsrp=$(grp "$nbr" 4); n_rsrq=$(grp "$nbr" 5); n_sinr=$(grp "$nbr" 6)
printf '{\n  "updated": %s,\n' "$(date +%s)"
printf '  "serving": { "arfcn": %s, "pci": %s, "band": "%s", "rsrp": "%s", "rsrq": "%s", "sinr": "%s" },\n' \
  "${s_arfcn:-0}" "${s_pci:-0}" "$s_band" "$(d100 "$s_rsrp")" "$(d100 "$s_rsrq")" "$(d100 "$s_sinr")"
printf '  "neighbors": ['
i=1; first=1
while [ $i -le 4 ]; do
  p=$(f "$n_pci" $i); a=$(f "$n_arfcn" $i); r=$(f "$n_rsrp" $i); q=$(f "$n_rsrq" $i); s=$(f "$n_sinr" $i)
  if [ -n "$p" ] && [ "$p" != 0 ]; then
    [ $first -eq 0 ] && printf ','
    first=0
    printf '\n    { "arfcn": %s, "pci": %s, "band": "%s", "rsrp": "%s", "rsrq": "%s", "sinr": "%s" }' \
      "${a:-0}" "$p" "$(band_of_arfcn "${a:-0}")" "$(d100 "$r")" "$(d100 "$q")" "$(d100 "$s")"
  fi
  i=$((i+1))
done
printf '\n  ]\n}\n'