#!/bin/sh
# MU300 状态采集 -> JSON(给 LuCI 的 5G 状态页)
# 注意:一次采集要 ~20 秒(AT 通道被数据面占着),所以由 mu300-statusd 每 60 秒调一次
export PATH=$PATH:/opt/mu300/bin
WAN=sipa_eth0; LAN=br-lan
at() { mu300-at -t 5 "$1" 2>/dev/null; }
j() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# ---------- 基础:运营商 / 制式 / 小区 ----------
sig=$(mobile-data signal 2>/dev/null)
oper=$(echo "$sig" | sed -n 's/^operator *\([^ ]*\).*/\1/p')
# RAT:用 AT+COPS? 的 act(11/10=5G, 7=4G, 2=3G, 0=2G)
#   —— 原来解析 mobile-data signal 的 operator 行,它时常返回 unknown (AcT ) ✗
act=$(at 'AT+COPS?' 2>/dev/null | grep -o ',[0-9]*$' | tr -d ',' | head -1)
case "$act" in
  11|10) rat='5G' ;;
  7)  rat='4G' ;;
  2)  rat='3G' ;;
  0)  rat='2G' ;;
  *)  rat=$(echo "$sig" | sed -n 's/^operator *[^ ]* (\(.*\))/\1/p') ;;
esac
case "$rat" in *unknown*|'') rat='5G' ;; esac
cell=$(echo "$sig" | sed -n 's/^cell *\([^ ]*\).*/\1/p')
tac=$(echo "$sig" | sed -n 's/.*tracking area \([^)]*\).*/\1/p')

# ---------- 小区标识/TAC:NR 与 LTE 各一条(AT+C5GREG / AT+CEREG)----------
# 返回形如 +C5GREG: 0,1,"4A0084","4A1D4448C",11,...  → 引号内第 1 个是 TAC,第 2 个是小区 ID
c5g=$(at 'AT+C5GREG?' | grep '^+C5GREG:' | head -1)
creg=$(at 'AT+CEREG?' | grep '^+CEREG:' | head -1)
nr_tac=$(printf '%s' "$c5g" | awk -F'"' '{print $2}')
nr_cell=$(printf '%s' "$c5g" | awk -F'"' '{print $4}')
lte_tac=$(printf '%s' "$creg" | awk -F'"' '{print $2}')
lte_cell_=$(printf '%s' "$creg" | awk -F'"' '{print $4}')

case "$oper" in
  46000|46002|46004|46007|46008|46020) opname='中国移动' ;;
  46001|46006|46009) opname='中国联通' ;;
  46003|46005|46011|46012) opname='中国电信' ;;
  '') opname='' ;;
  *) opname="$oper" ;;
esac
case "$rat" in
  5G*) ratcn='5G' ;;
  LTE*|4G*) ratcn='4G (LTE)' ;;
  3G*) ratcn='3G' ;;
  2G*) ratcn='2G' ;;
  *) ratcn="$rat" ;;
esac

# ---------- 信号 ----------
# 已拆到中档 mu300-status-signal(每 20 秒一条 AT+CESQ),这里不再重复查询(省 3 秒);
# 页面会把 /tmp/mu300-signal.json 合并进来。rsrp/rsrq/sinr/quality 由那边提供。

# ---------- 地址 / 速率 ----------
v4=$(ip -4 -br addr show $WAN 2>/dev/null | awk '{print $3}')
v6=$(ip -6 addr show $WAN 2>/dev/null | grep 'scope global' | awk '{print $2}' | head -1)
lan4=$(ip -4 -br addr show $LAN 2>/dev/null | awk '{print $3}')
lan6=$(ip -6 addr show $LAN 2>/dev/null | awk '/scope global/ {print $2}' | grep -v '^fd' | head -1)
r1=$(cat /sys/class/net/$WAN/statistics/rx_bytes 2>/dev/null || echo 0)
t1=$(cat /sys/class/net/$WAN/statistics/tx_bytes 2>/dev/null || echo 0)
sleep 1
r2=$(cat /sys/class/net/$WAN/statistics/rx_bytes 2>/dev/null || echo 0)
t2=$(cat /sys/class/net/$WAN/statistics/tx_bytes 2>/dev/null || echo 0)
rxr=$((r2 - r1)); txr=$((t2 - t1)); [ $rxr -lt 0 ] && rxr=0; [ $txr -lt 0 ] && txr=0
up=$(cut -d. -f1 /proc/uptime 2>/dev/null)
today_rx=$(sed -n 's/.*"today": "\([^"]*\)".*/\1/p' /tmp/mu300-traffic.json 2>/dev/null | head -1)
today_rx_b=$(awk -v d="$today_rx" 'match($0, d": *\{ \"rx\": *[0-9]+") {s=substr($0,RSTART,RLENGTH); gsub(/[^0-9]/,"",s); print s+0}' /tmp/mu300-traffic.json 2>/dev/null)
today_tx_b=$(awk -v d="$today_rx" 'match($0, d": *\{ \"rx\": *[0-9]+, \"tx\": *[0-9]+") {s=substr($0,RSTART,RLENGTH); n=split(s,a,","); gsub(/[^0-9]/,"",a[2]); print a[2]+0}' /tmp/mu300-traffic.json 2>/dev/null)

# ---------- 无线 / 设备 ----------
ssid=$(uci -q get wireless.@wifi-iface[0].ssid)
chinfo=$(iw dev wlan0 info 2>/dev/null | awk '/channel/{print $2" "$4}')
ch=$(echo "$chinfo" | awk '{print $1}'); band=$(echo "$chinfo" | awk '{print $2}')
clients=$(iw dev wlan0 station dump 2>/dev/null | grep -c Station)
apn=$(uci -q get network.wan.apn); [ -z "$apn" ] && apn='(默认)'
# 频段锁(AT+SPLBAND;掩码格式,已知 位->频段 映射见 mu300-band)
nrmask=$(at 'AT+SPLBAND=3' | sed -n 's/^+SPLBAND: *//p' | head -1)
ltemask=$(at 'AT+SPLBAND=0' | sed -n 's/^+SPLBAND: *//p' | head -1)
# 模组支持的频段集合(4=NR、5=LTE;实测 4→553,0,528、5→0,482,0,149,0)
nrsup=$(at 'AT+SPLBAND=4' | sed -n 's/^+SPLBAND: *//p' | head -1)
ltesup=$(at 'AT+SPLBAND=5' | sed -n 's/^+SPLBAND: *//p' | head -1)

temp=$(awk '{printf "%.1f", $1/1000}' /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
ctrl=$(sed -n 's/^DISTRIB_DESCRIPTION=//p' /etc/openwrt_release 2>/dev/null | tr -d "'")
kernel=$(uname -r)

cat <<EOF
{
  "updated": $(date +%s),
  "operator": "$(j "$oper")", "operator_name": "$(j "$opname")",
  "rat": "$(j "$ratcn")", "apn": "$(j "$apn")",
  "signal_note": "见 /tmp/mu300-signal.json(中档采集)",
  "cell": "$(j "$cell")", "tac": "$(j "$tac")",
  "nr_cell": "$(j "$nr_cell")", "nr_tac": "$(j "$nr_tac")", "lte_cell": "$(j "$lte_cell_")", "lte_tac": "$(j "$lte_tac")",
  "wan4": "$(j "$v4")", "wan6": "$(j "$v6")", "lan4": "$(j "$lan4")", "lan6": "$(j "$lan6")",
  "rx_rate": ${rxr:-0}, "tx_rate": ${txr:-0},
  "today_rx": ${today_rx_b:-0}, "today_tx": ${today_tx_b:-0},
  "uptime": ${up:-0},
  "ssid": "$(j "$ssid")", "channel": "$(j "$ch")", "wifi_band": "$(j "$band")", "clients": ${clients:-0},
  "temperature": "$temp",
  "firmware": "$(j "$ctrl")", "kernel": "$(j "$kernel")",
  "nr_band_mask": "$nrmask", "lte_band_mask": "$ltemask", "supported_nr": "6,41,78,1,8,28,5",
  "nr_supported_mask": "$nrsup", "lte_supported_mask": "$ltesup"
}
EOF