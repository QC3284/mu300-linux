#!/bin/sh /etc/rc.common
# mu300-ttyd:网页终端(对齐 UFI 的"无线ADB")
#   访问 http://<设备IP>:7681/  →  终端里直接出现 login: 提示
#   ★ 不加 -c(那是 HTTP Basic,浏览器会弹自己的框 ✗)
#     安全性由 /bin/login 保证:终端里必须输 root + 密码 ✓
START=97
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/ttyd -p 7681 -W /bin/login
	procd_set_param respawn 3600 5 5
	procd_close_instance
}