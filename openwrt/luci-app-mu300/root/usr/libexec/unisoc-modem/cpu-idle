#!/bin/sh
action=${1:-get}
case "$action" in get|apply|boot) ;; *) exit 2 ;; esac
if [ "$action" != get ]; then
    exec 9>"${UNISOC_IDLE_LOCK:-/run/unisoc-cpu-idle.lock}" || exit 1
    flock -n 9 || { echo '{"ok":false,"error":"CPU0 深度休眠设置正忙"}'; exit 1; }
fi
exec ucode "${UNISOC_IDLE_LIB:-/usr/libexec/unisoc-modem/cpu-idle.uc}" "$action"
