# The clock providers, the reason SPRD_COMMON_CLK alone registered nothing:
# drivers/clk/sprd/Kconfig gates every SoC clock driver on  (ARM64 && ARCH_SPRD) || COMPILE_TEST,
# so without ARCH_SPRD the framework builds (sprd_clk_probe present) but no controller driver does.
CONFIG_ARCH_SPRD=y
CONFIG_SPRD_COMMON_CLK=y
CONFIG_SPRD_UMS512_CLK=y
CONFIG_SPRD_SC9860_CLK=y
CONFIG_SPRD_SC9863A_CLK=y
CONFIG_COMMON_CLK_SC27XX=y
CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_SCPI=y
