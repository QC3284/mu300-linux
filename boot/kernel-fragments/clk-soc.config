# Exact symbol names read from the WORKING kernel's config (device-eng3):
#   the UDC is the DWC3 at 0x25100000 (the MUSB node is unused), the clock providers are the ums9620-* ones,
#   and the USB3 PHY is the vendor SS PHY.
CONFIG_ARCH_SPRD=y
CONFIG_SPRD_COMMON_CLK=y
CONFIG_SPRD_UMS9620_CLK=y
CONFIG_SPRD_UMS512_CLK=y
CONFIG_SPRD_SC9860_CLK=y
CONFIG_SPRD_SC9863A_CLK=y
CONFIG_COMMON_CLK_SC27XX=y
CONFIG_COMMON_CLK=y
CONFIG_ARCH_SPRD=y
CONFIG_USB_SPRD_UMS9620_SSPHY=y
CONFIG_PHY_SPRD_USB3=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_GENERIC=y
CONFIG_USB_DWC3_OF_SIMPLE=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_SPRD=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_EXTCON=y
CONFIG_NOP_USB_XCEIV=y
