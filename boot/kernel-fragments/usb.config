# USB stack the carried kernel has and allnoconfig+mainline.config does not: without it every USB-dependent
# module (btusb, mt76-usb, mt792x, rt2800usb, rt2x00usb, snd-usb*, ump9620-tcpc) fails to load.
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_COMMON=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_STORAGE_NUM_BUFFERS=2
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_SPRD=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_EXTCON=y
CONFIG_PHY_SPRD_USB3=y
CONFIG_PHY_SPRD=y
