# Clock PROVIDERS, built in: with them as modules or absent every consumer fails 'can't get the clock'
# (i2c, hwspinlock, sdhci, dwc3). The pinctrl works, so the DTB side is right; only the providers were missing.
CONFIG_COMMON_CLK=y
CONFIG_SPRD_CLK=y
CONFIG_SPRD_PMIC_CLK=y
CONFIG_COMMON_CLK_SC27XX=y
CONFIG_SPMI=y
CONFIG_SPMI_SPRD=y
CONFIG_SPRD_PMU=y
CONFIG_SPRD_PMIC=y
CONFIG_MFD_SPRD=y
CONFIG_MFD_SC27XX_PMIC=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_SC27XX=y
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_SPRD=y
CONFIG_PINCTRL_SPRD=y
CONFIG_SERIAL_SPRD=y
CONFIG_I2C=y
CONFIG_I2C_SPRD=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_SPRD=y
