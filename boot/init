#!/bin/busybox sh
# MU300 standalone Linux initramfs v10 (switch_root to Ubuntu on the free eMMC region; comm fix; custom kernel + modem_control + node perms + slot a modem) (slot b, tries=2 one-shot trial).
# Every stage is written to /dev/kmsg at KERN_ERR so it survives in
# /sys/fs/pstore/console-ramoops-0 after the fallback boot into Android.
/bin/busybox mkdir -p /bin /sbin /proc /sys /dev /run /tmp /root /etc /config
/bin/busybox --install -s /bin
export PATH=/bin:/sbin HOME=/root TERM=vt100
mount -t proc proc /proc
mount -t sysfs sysfs /sys
echo 7 > /proc/sys/kernel/printk
# the custom kernel has devtmpfs; fall back to tmpfs + mknod for safety
if ! mount -t devtmpfs -o mode=0755 devtmpfs /dev; then
    mount -t tmpfs -o mode=0755 tmpfs /dev
    mknod /dev/null c 1 3
    mknod /dev/console c 5 1
    mknod /dev/kmsg c 1 11
    mknod /dev/zero c 1 5
    mknod /dev/urandom c 1 9
fi
pmsg_major=$(awk '$2=="pmsg"{print $1}' /proc/devices)
[ -n "$pmsg_major" ] && [ ! -e /dev/pmsg0 ] && mknod /dev/pmsg0 c "$pmsg_major" 0

log() {
    echo "<3>MU300-LINUX: $*" > /dev/kmsg
    [ -c /dev/pmsg0 ] && echo "MU300-LINUX: $*" > /dev/pmsg0
    [ -d /run ] && echo "$(cut -d' ' -f1 /proc/uptime) $*" >> /run/stages
}

# Persistent log: 8 MiB at 48 MiB inside boot_b, past the image and its AVB data
# (image ends near 39 MiB). Survives a cold power cycle, unlike pstore.
bootb=
persist() {
    # subshells (the reboot timer) started before the eMMC was found learn the device from this file
    [ -n "$bootb" ] || bootb=$(cat /run/bootb 2>/dev/null)
    [ -n "$bootb" ] && [ -b "$bootb" ] || return
    # the periodic loop and the reboot timer both call this
    mkdir /run/persist.lock 2>/dev/null || return
    {
        echo "MU300-PERSIST-BEGIN uptime=$(cut -d' ' -f1 /proc/uptime)"
        cat /run/stages
        echo "--- lsmod"
        cat /proc/modules
        echo "--- udc"
        ls /sys/class/udc 2>&1
        echo "--- logcat"
        tail -c 400000 /run/logcat.txt 2>&1
        echo "--- modem_control"
        cat /run/modem_control.log 2>&1 | tail -c 200000
        echo "--- deferred"
        cat /sys/kernel/debug/devices_deferred 2>&1
        echo "--- dmesg"
        dmesg | tail -c 6000000
        echo "MU300-PERSIST-END"
    } > /run/persist.txt 2>&1
    head -c 65536 /dev/zero >> /run/persist.txt
    dd if=/run/persist.txt of="$bootb" bs=4096 seek=12288 count=2048 conv=notrunc 2>/dev/null
    sync
    rmdir /run/persist.lock
}
log "stage=init-start pid=$$"

mkdir -p /dev/pts
mount -t devpts -o mode=0620,ptmxmode=0666 devpts /dev/pts
ln -sf pts/ptmx /dev/ptmx
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
mount -t debugfs debugfs /sys/kernel/debug
echo /bin/mdev > /proc/sys/kernel/hotplug
mdev -s
log "stage=devfs-ready"

# v8c8b:启动期 LED 白闪 —— **后台轮询**(每 0.5s 重试,最多 60s),不再只试一次。
# 原因:LED 驱动(led-class + leds-sc27xx-bltc)是模块,节点要等模块加载后才出现;
# 现在已把这两个模块挪到 module-order 最前,同时这里轮询兜底;跑在**后台**不拖慢启动。
# 颜色用【白】(硬件事实:F50 的 green 通道实际显白,可用色只有红/白/蓝);点白前显式清红蓝。
led_boot_blink() {
    _busy=/bin/busybox; [ -x "$_busy" ] || _busy=busybox
    _i=0
    while [ "$_i" -lt 120 ]; do
        if [ -w /sys/class/leds/sc27xx:green/trigger ]; then
            for c in sc27xx:red sc27xx:blue; do
                echo none > "/sys/class/leds/$c/trigger" 2>/dev/null
                echo 0    > "/sys/class/leds/$c/brightness" 2>/dev/null
            done
            echo none  > /sys/class/leds/sc27xx:green/trigger 2>/dev/null
            echo 0     > /sys/class/leds/sc27xx:green/brightness 2>/dev/null
            echo timer > /sys/class/leds/sc27xx:green/trigger 2>/dev/null
            echo ${LED_BOOT_MS:-200} > /sys/class/leds/sc27xx:green/delay_on 2>/dev/null
            echo ${LED_BOOT_MS:-200} > /sys/class/leds/sc27xx:green/delay_off 2>/dev/null
            log "stage=led-boot-blink hz=2.5 color=white on=${LED_BOOT_MS:-200}ms R=0 B=0 waited=${_i}x0.5s"
            return 0
        fi
        "$_busy" sleep 0.5 2>/dev/null || sleep 1
        _i=$((_i + 1))
    done
    log "stage=led-boot-blink skipped (no sc27xx:green after 60s)"
    return 1
}
led_boot_blink &

# Turn hangs into panics; the vendor kernel reboots after a panic.
echo 1 > /proc/sys/kernel/softlockup_panic
echo 1 > /proc/sys/kernel/panic_on_oops
[ -e /proc/sys/kernel/hardlockup_panic ] && echo 1 > /proc/sys/kernel/hardlockup_panic
echo 1 > /proc/sys/kernel/sysrq

# Safety net: reboot after 5 minutes. By then misc points back at slot a.
# Create /run/stay (e.g. over telnet) to keep Linux running.
(sleep 300
 if [ -e /run/stay ]; then log "stage=timer-skipped"; exit 0; fi
 log "stage=timer-reboot"
 while ! persist_done=$(mkdir /run/persist.lock 2>/dev/null && echo 1); do sleep 1; done
 rmdir /run/persist.lock
 persist; reboot -f; sleep 10; echo b > /proc/sysrq-trigger) &

# Which device this is. The ZTE U30 Air is the F50's board with a battery: ZTE's SQC charger stack, USB-PD, LEDs.
# It runs the same kernel with its own build of a few modules (linux-modules/u30air/, see kernel/build-u30air.sh)
# and its own load order; without them the charger manager never probes and USB stays down. The installer names
# the device in /etc/mu300-device (the device segment of the ramdisk, which the generic segment of an update does
# not replace); without that file the stock device tree tells: only the U30 Air's has the charger policy service.
if [ -s /etc/mu300-device ]; then
    DEVICE=$(cat /etc/mu300-device)
elif [ -d /proc/device-tree/charger_policy_service ]; then
    DEVICE=u30air
else
    DEVICE=f50
fi
# its modules only for the kernel they were built for (a mainline kernel brings its own set and order)
MODULE_ORDER=/etc/module-order
if [ "$DEVICE" != f50 ] && [ -s /etc/module-order-$DEVICE ] &&
   [ "$(cat /linux-modules/$DEVICE/kernel.release 2>/dev/null)" = "$(uname -r)" ]; then
    MODULE_ORDER=/etc/module-order-$DEVICE
else
    DEVICE_MODULES=none
fi
log "stage=device $DEVICE order=$MODULE_ORDER"

# ── MU300 v8c2:阶段 2(可选模块,有界加载 + 失败可诊断)────────────────────────
# etc/module-order 的前 EXTRA_FROM 项(41,v7 核心集)由阶段 1 按原序同步加载,其余在这里。
# v8c2 相对 v8b 的增强(**全部为可诊断性,不改变加载策略**):
#   1) 失败时打印**模块名 + rc + 实际使用的文件路径 + insmod 的完整 stderr**(压成一行,便于 grep);
#   2) 清单里有、ramdisk 里没有的项直接识别为 **not-found(幽灵名)**并单独计数,不再空跑 insmod;
#   3) 结束行给出 loaded/failed/ghost/skipped + **failed-list(失败模块名+rc)**,一眼能看出该查谁;
#   4) 阶段 2 的路径解析与阶段 1 完全一致(含 U30 Air 的 /linux-modules/<device>/ 回退)——
#      v8b 这里硬编码 /linux-modules/$module,在 device!=f50 的机器上会整片 not-found。
EXTRA_FROM=${EXTRA_FROM:-46}
EXTRA_BUDGET=${EXTRA_BUDGET:-90}          # 保留:仅作为日志对照,不再是“硬跳过”依据
EXTRA_BATCH=${EXTRA_BATCH:-8}                # v8c5:每批并行加载数
EXTRA_BATCH_WAIT=${EXTRA_BATCH_WAIT:-12}    # v8c5:每批等待上限(秒),超时即继续,慢模块留在后台
EXTRA_RISK="sprd_thermal_r5p0.ko hci_uart.ko virtio.ko virtio_ring.ko virtio_mmio.ko cfg80211.ko bluetooth.ko bnep.ko rfcomm.ko leds-sc27xx-bltc.ko spi-sprd-adi.ko"
extra_file() {   # extra_file MODULE -> 打印实际文件路径(与阶段 1 同规则)
    _f="/linux-modules/$1"
    if [ -n "${DEVICE_MODULES:-}" ] && [ -f "/linux-modules/${DEVICE:-f50}/$1" ]; then
        _f="/linux-modules/${DEVICE:-f50}/$1"
    fi
    echo "$_f"
}
load_extra_modules() {
    [ -f "$MODULE_ORDER" ] || return 0
    t0=$(date +%s); loaded=0; failed=0; ghost=0; skipped=0; v8b_n=0; failed_list=""; slow_list=""
    : > /run/insmod-extra.done
    batch=""; bn=0
    run_batch() {
        [ -n "$1" ] || return 0
        : > /run/insmod-extra.done
        n=0
        for m in $1; do
            f=$(extra_file "$m")
            to=5; for r in $EXTRA_RISK; do [ "$r" = "$m" ] && to=2; done
            ( t=$(date +%s)
              timeout "$to" insmod "$f" 2>/run/insmod-extra.err; rc=$?
              d=$(( $(date +%s) - t ))
              echo "$rc $d $m" >> /run/insmod-extra.done ) &
            n=$((n + 1))
        done
        # 等这一批:最久 EXTRA_BATCH_WAIT 秒。timeout 杀不掉内核里 D 状态的 probe,
        # 所以到点就继续,把慢模块留在后台 —— 关键是不再让它们挡住启动。
        w=0
        while [ "$w" -lt "$EXTRA_BATCH_WAIT" ]; do
            [ "$(grep -c . /run/insmod-extra.done 2>/dev/null)" -ge "$n" ] && break
            sleep 1; w=$((w + 1))
        done
        while read rc d m; do
            [ "$rc" = 0 ] && loaded=$((loaded + 1)) || { failed=$((failed + 1)); failed_list="$failed_list $m(rc=$rc)"; }
            if [ "$d" -ge 3 ]; then slow_list="$slow_list $m:${d}s"; log "insmod-extra-slow module=$m rc=$rc secs=$d"; fi
        done < /run/insmod-extra.done
        got=$(grep -c . /run/insmod-extra.done 2>/dev/null)
        if [ "$got" -lt "$n" ]; then
            log "insmod-extra-batch-timeout batch=$1 pending=$((n - got)) (慢模块留在后台,继续)"
            loaded=$((loaded + got))
        fi
    }
    while read module; do
        case "$module" in ''|'#'*) continue ;; esac
        v8b_n=$((v8b_n + 1))
        [ "$v8b_n" -le "$EXTRA_FROM" ] && continue
        file=$(extra_file "$module")
        if [ ! -f "$file" ]; then
            ghost=$((ghost + 1))
            log "insmod-extra-skip module=$module reason=not-found file=$file"
            continue
        fi
        batch="$batch $module"; bn=$((bn + 1))
        if [ "$bn" -ge "$EXTRA_BATCH" ]; then run_batch "$batch"; batch=""; bn=0; fi
    done < "$MODULE_ORDER"
    [ -n "$batch" ] && run_batch "$batch"
    log "stage=extra-modules done loaded=$loaded failed=$failed ghost=$ghost skipped=$skipped batch=$EXTRA_BATCH budget=${EXTRA_BUDGET}s from=${EXTRA_FROM} slow=${slow_list:-none} failed-list=${failed_list:-none}"
}

load_vendor_modules() {
    v8b_n=0   # v8b:阶段 1 计数器
    if [ -z "$EXTRA_FROM" ]; then EXTRA_FROM=46; fi
    loaded=0
    failed=0
    failed_list=""
    while read module; do
        # t15: a blank line or a "#" comment is not a module name. The order file we generate has neither,
        # but a comment line used to be insmod'ed verbatim - which showed up as "insmod-fail # ..." and made
        # the stage read "loaded=44 failed=1" (a false alarm: nothing branches on the counter, but it lies).
        # read strips leading/trailing IFS whitespace, so an indented comment arrives as "#...".
        v8b_n=$((v8b_n + 1))
        [ "$v8b_n" -gt "$EXTRA_FROM" ] && break   # v8b:之后属于阶段 2
        case "$module" in
            ''|'#'*) continue ;;
        esac
        # vendor_boot's /lib/modules were built for the stock kernel; only our rebuilt copies match
        file="/linux-modules/$module"
        [ -z "${DEVICE_MODULES:-}" ] && [ -f "/linux-modules/$DEVICE/$module" ] && file="/linux-modules/$DEVICE/$module"
        if insmod "$file" 2>/run/insmod.err; then
            loaded=$((loaded + 1))
        else
            failed=$((failed + 1))
            failed_list="$failed_list $module"
            err=$(tr '\n' '|' < /run/insmod.err 2>/dev/null | cut -c1-200)
            log "insmod-fail module=$module file=$file err=$err"
        fi
    done < $MODULE_ORDER
    mdev -s
    log "stage=modules-done loaded=$loaded failed=$failed failed-list=${failed_list:-none}"
}

# misc and boot_b: where they are is known only once the eMMC is there, and its driver (sdhci-sprd) is one of
# the vendor modules - an earlier lookup found nothing (U30 Air: misc-NOT-FOUND, no persistent log). So this runs
# after load_vendor_modules; whether slot a is restored is decided once the rootfs is known.
misc=
find_partitions() {
    for n in $(seq 1 20); do
        for u in /sys/class/block/mmcblk*p*/uevent; do
            grep -qx PARTNAME=misc "$u" 2>/dev/null && misc=/dev/$(basename "$(dirname "$u")")
            grep -qx PARTNAME=boot_b "$u" 2>/dev/null && bootb=/dev/$(basename "$(dirname "$u")")
        done
        [ -b "$misc" ] && [ -b "$bootb" ] && break
        sleep 1
        mdev -s
    done
    [ -b "$misc" ] || misc=
    [ -b "$bootb" ] || bootb=
    echo "$bootb" > /run/bootb
    log "stage=persist-target dev=${bootb:-none} misc=${misc:-none}"
    persist
    (while :; do sleep 15; persist; done) &
}

write_misc_bc() {  # write_misc_bc FILE STAGE
    [ -n "$misc" ] || { log "stage=misc-NOT-FOUND"; return 1; }
    dd if="$1" of="$misc" bs=1 seek=2048 conv=notrunc 2>/dev/null
    sync
    dd if="$misc" of=/run/bc.bin bs=1 skip=2048 count=32 2>/dev/null
    if cmp -s /run/bc.bin "$1"; then log "stage=$2 dev=$misc"; else log "stage=$2-MISMATCH dev=$misc"; fi
}
restore_slot_a() { write_misc_bc /etc/misc-bc-slot-a.bin misc-restored; }

hostname mu300-linux
ifconfig lo 127.0.0.1 up
setup_usb_gadget() {
    log "stage=usb-configfs"
    mount -t configfs configfs /config
    g=/config/usb_gadget/linux
    mkdir -p "$g/strings/0x409" "$g/configs/c.1/strings/0x409"
    # The USB network functions: whichever of these the kernel actually has. Creating one it was not built with
    # fails here, and a gadget that is never bound leaves the device with no console and no network at all - which
    # is exactly what an "improvement" to NCM cost once (on a mainline build without it; both kernels have it now).
    # NCM by default, in a single configuration with the ACM console: Windows 10 2004+/11 bind their inbox
    # UsbNcm.sys to it, macOS and Linux their own drivers - all measured, none needs an INF. ECM, which Windows has
    # no driver for, is the fallback. MU300_USBNET (kernel command line) picks the functions.
    # "rndis ncm" is for Windows without NCM (7, 8, 10 before 2004): RNDIS gets configuration 1 and NCM moves to
    # configuration 2. Windows only ever uses the first, and binds rndis.sys to it through the MS OS descriptors
    # below; Linux skips RNDIS configurations on purpose. macOS does not: it takes configuration 1 as well, finds
    # no driver for RNDIS and has no network (measured) - which is why RNDIS is not the default.
    rndis= netfunc=
    for f in ${MU300_USBNET:-ncm ecm}; do
        case $f in
            rndis) [ -z "$rndis" ] && mkdir -p "$g/functions/rndis.rn0" 2>/dev/null && rndis=1 ;;
            *) [ -z "$netfunc" ] && mkdir -p "$g/functions/$f.usb0" 2>/dev/null && netfunc=$f ;;
        esac
    done
    [ -n "$netfunc$rndis" ] || log "stage=usb-no-net-function (console only)"
    cdc=c.1
    [ -n "$rndis" ] && cdc=c.2
    echo 0x0525 > "$g/idVendor"
    echo 0xa4a1 > "$g/idProduct"
    echo 0x0200 > "$g/bcdUSB"
    # Windows asks for the MS OS descriptors (below) once per VID/PID/bcdDevice and caches the answer, "none"
    # included: the default bcdDevice follows the kernel version and was cached as "none" by every PC that met
    # the earlier gadget. A value of our own makes them ask again. Change it whenever the descriptors change.
    echo 0x0301 > "$g/bcdDevice"
    # Miscellaneous / IAD: the network and the ACM functions each span two interfaces, and without this device class
    # Windows' composite driver ignores their association descriptors and hands out the interfaces one by one, so a
    # class driver never sees its function as a whole
    echo 0xEF > "$g/bDeviceClass"
    echo 0x02 > "$g/bDeviceSubClass"
    echo 0x01 > "$g/bDeviceProtocol"
    echo MU300LINUX > "$g/strings/0x409/serialnumber"
    echo Linux > "$g/strings/0x409/manufacturer"
    echo "MU300 Linux USB Ethernet" > "$g/strings/0x409/product"
    # USB serial console alongside the network function, in every configuration: recovery/debug access that does
    # not depend on networking
    mkdir -p "$g/functions/acm.GS0"
    if [ -n "$rndis" ]; then
        echo "RNDIS + ACM console" > "$g/configs/c.1/strings/0x409/configuration"
        echo 250 > "$g/configs/c.1/MaxPower"
        echo 02:50:00:00:77:03 > "$g/functions/rndis.rn0/dev_addr"
        echo 02:50:00:00:77:04 > "$g/functions/rndis.rn0/host_addr"
        ln -s "$g/functions/rndis.rn0" "$g/configs/c.1/f1"
        ln -s "$g/functions/acm.GS0" "$g/configs/c.1/f2"
        # MS OS descriptors: Windows asks for them with vendor request 0xcd and binds rndis.sys by compatible ID.
        # They are what identifies the function: the stock f_rndis' control interface is 02/02/ff, which Windows
        # would otherwise hand to usbser (a device with two configurations is never composite on Windows, so the
        # first interface names the whole device).
        echo 1 > "$g/os_desc/use"
        echo 0xcd > "$g/os_desc/b_vendor_code"
        echo MSFT100 > "$g/os_desc/qw_sign"
        echo RNDIS > "$g/functions/rndis.rn0/os_desc/interface.rndis/compatible_id"
        echo 5162001 > "$g/functions/rndis.rn0/os_desc/interface.rndis/sub_compatible_id"
        ln -s "$g/configs/c.1" "$g/os_desc/c.1"
    fi
    if [ -n "$netfunc" ] || [ -z "$rndis" ]; then
        mkdir -p "$g/configs/$cdc/strings/0x409"
        echo "${netfunc:-no} net + ACM console" > "$g/configs/$cdc/strings/0x409/configuration"
        echo 250 > "$g/configs/$cdc/MaxPower"
        if [ -n "$netfunc" ]; then
            echo 02:50:00:00:77:01 > "$g/functions/$netfunc.usb0/dev_addr"
            echo 02:50:00:00:77:02 > "$g/functions/$netfunc.usb0/host_addr"
            ln -s "$g/functions/$netfunc.usb0" "$g/configs/$cdc/f1"
        fi
        ln -s "$g/functions/acm.GS0" "$g/configs/$cdc/f2"
    fi
    log "stage=usb-net-function ${rndis:+rndis+}${netfunc:-none}"
    log "stage=usb-wait-udc"
    for n in $(seq 1 40); do
        [ -e /sys/class/udc/25100000.dwc3 ] && break
        sleep 1
    done
    udc=
    [ -e /sys/class/udc/25100000.dwc3 ] && udc=25100000.dwc3
    [ -z "$udc" ] && for u in /sys/class/udc/*; do [ -e "$u" ] && { udc=$(basename "$u"); break; }; done
    log "stage=udc udc=${udc:-none} available=$(ls /sys/class/udc 2>/dev/null | tr '\n' ',')"
    persist
    sleep 1
    # Never rebind the gadget from a shell running on its own ACM console: the console dies with the unbind and the
    # rebind never runs, which leaves the device with no USB at all until it is power-cycled.
    log "stage=usb-bind-start"
    [ -n "$udc" ] && echo "$udc" > "$g/UDC"
    log "stage=usb-bind-done rc=$?"
    persist

    # The functions register their netdevs as they are bound, configuration by configuration, so RNDIS would take
    # usb0 - the name lan-start and the OpenWrt bridge expect for the CDC link. Name them by function instead.
    if [ -n "$rndis" ]; then
        r=$(cat "$g/functions/rndis.rn0/ifname" 2>/dev/null)
        c=$(cat "$g/functions/$netfunc.usb0/ifname" 2>/dev/null)
        case $r in ""|"(unnamed net_device)"|rndis0) ;; *) ip link set "$r" name rndis0 ;; esac
        case $c in ""|"(unnamed net_device)"|usb0) ;; *) ip link set "$c" name usb0 ;; esac
        log "stage=usb-ifnames rndis=$r->rndis0 cdc=${c:-none}->usb0"
        ifconfig rndis0 up
    fi

    # Bring usb0 up immediately after binding, before the host selects the data interface:
    # f_ecm (and f_ncm alike) reports the link state in its first CONNECT notification, and macOS' ECM driver does not
    # pick up a later "connected" notification (v10 left usb0 down until systemd ran -> host "inactive").
    ifconfig usb0 up
}

# The vendor modules first, the gadget last. The host starts asking for a DHCP lease the moment the gadget
# appears and gives up after a few seconds, so the closer the gadget comes to the system that answers (the DHCP
# server starts right after switch_root), the more reliably the host gets an address.
load_vendor_modules
find_partitions
setup_usb_gadget

# ── MU300 v8b:阶段 2(可选模块)。放在这里 = 救援通道/网络已经起来之后。
load_extra_modules

# --- MU300/F50 v8c4: the IPA delegate is NOT loaded here anymore -------------------------
# t29 profiling: the ramdisk used to insmod sipa-dele.ko and wait up to 150 s for the delegate
# thread (observed: 86.35 s, "get resource failed for remote-base! / dts parsing failed", plus the
# extra-modules loop burning its whole 90 s budget). That is wrong twice over: the resource simply
# is not there at 2.4-6.7 s (the modem only starts talking once modem_control has the CP up, ~60 s),
# and a *successful* early insmod is worse because sipa_dele is [permanent] - a delegate thread that
# missed channel 120 stays dead for the whole boot with no way to reload it.
# The delegate is therefore loaded by userspace, after the modem: /opt/mu300/bin/sipa-dele-start
# (driven from /opt/mu300/bin/extra-modules) waits for the modem and insmods it in the background.
# sipa-dele.ko is also no longer listed in etc/module-order.
ROOT_OFFSET=27762098176   # linux-boot/rootfs-region.env; outside every GPT partition
# The region is not at the same place on every device (eMMC size, partition layout), and a number in this file is
# not enough: the installer writes the device's offset in here, but the generic ramdisk segment that updates put
# behind this one (mu300-update, and a mainline kernel from the installer) carries its own init, which replaces
# this file - with the default above. Devices whose region is elsewhere then booted into standalone mode and went
# back to Android. So find it the way the installer places it - the first 2 MiB boundary after the last partition
# - and take the first candidate that really holds the mu300root filesystem (ext4 magic and label).
is_mu300root() {  # is_mu300root OFFSET
    [ "$(dd if=/dev/mmcblk0 bs=1 skip=$(($1 + 1080)) count=2 2>/dev/null | od -An -tx1 | tr -d ' \n')" = 53ef ] &&
    [ "$(dd if=/dev/mmcblk0 bs=1 skip=$(($1 + 1144)) count=9 2>/dev/null)" = mu300root ]
}
find_root_offset() {
    e=0
    for p in /sys/block/mmcblk0/mmcblk0p*; do
        [ -r "$p/start" ] || continue
        x=$(( $(cat "$p/start") + $(cat "$p/size") ))
        [ "$x" -gt "$e" ] && e=$x
    done
    for c in $(( (e / 4096 + 1) * 4096 * 512 )) $ROOT_OFFSET; do
        is_mu300root "$c" && { echo "$c"; return 0; }
    done
    return 1
}
# --- B4:SD 旁路(TF 卡上的 Linux 根)--------------------------------------------------------
# 优先级:插着合格的 TF(ext4 + label mu300sd)⇒ 从 TF 起;否则【原样走下面既有逻辑】
# (fulldumpdb 分区 → 上游 ROOT_OFFSET 探测)。防变砖五条:① TF 是可选不是优先,探测/挂载失败
# 一律回既有路径;② 只读探测,不写任何分区/misc;③ 复用既有 .mu300/boot-attempts 回退语义;
# ④ 保留 /run/stay 与定时器保险;⑤ 全过程写 stage= 日志。
is_mu300sd() {  # is_mu300sd BLOCKDEV
    [ -b "$1" ] || return 1
    [ "$(dd if="$1" bs=1 skip=1080 count=2 2>/dev/null | od -An -tx1 | tr -d ' \n')" = 53ef ] || return 1
    [ "$(dd if="$1" bs=1 skip=1144 count=8 2>/dev/null)" = mu300sd ] || return 1
    return 0
}
tfroot=
for d in /dev/mmcblk[1-9]p1 /dev/mmcblk[1-9] /dev/mmcblk[1-9]p*; do
    [ -b "$d" ] || continue
    if is_mu300sd "$d"; then tfroot=$d; break; fi
done
if [ -n "$tfroot" ]; then
    log "stage=tf-scan dev=$tfroot label=mu300sd result=hit"
else
    log "stage=tf-scan dev=none label=mu300sd result=miss fallback=emmc"
fi

# --- MU300/F50 local change (v3 / t13) ------------------------------------------------------
# This unit's GPT covers the whole eMMC (no free tail region): the Linux root filesystem lives
# in the repurposed "fulldumpdb" GPT partition (2 GiB crash-dump target, unused in normal
# operation), not in the upstream "linux region" behind the last partition. Locate it by
# PARTNAME, exactly like misc/boot_b above (boot/rescue/init-rescue does the same).
# find_root_offset() is what t11's trial image died in: it reads the raw eMMC at the eMMC tail
# and logged nothing at all, so the whole offset probe is skipped when that partition exists.
# Devices without it keep the upstream path, unchanged.
rootpart=
for u in /sys/class/block/mmcblk*p*/uevent; do
    grep -qx PARTNAME=fulldumpdb "$u" 2>/dev/null && rootpart=/dev/$(basename "$(dirname "$u")")
done
# B4:TF 优先 —— 探测到的 TF 直接走下面既有的「直接 mount 块设备」分支(rootpart),
# 不引入任何新挂载代码。tfroot 为空(没插卡/卡不合格/只读探测失败)⇒ 此处什么都不做,
# 后续逻辑与接线前完全一致(fulldumpdb → 上游 ROOT_OFFSET 探测)。
if [ -n "$tfroot" ]; then
    rootpart=$tfroot
    log "stage=tf-root dev=$tfroot (direct-block-device mount path)"
fi
if [ -n "$rootpart" ]; then
    log "stage=rootpart dev=$rootpart (PARTNAME=fulldumpdb; upstream ROOT_OFFSET probe skipped)"
    ROOT_OFFSET=0
else
    if found=$(find_root_offset); then
        [ "$found" = "$ROOT_OFFSET" ] || log "stage=root-offset found=$found (default $ROOT_OFFSET)"
        ROOT_OFFSET=$found
    else
        log "stage=root-offset not-found (trying the default $ROOT_OFFSET)"
    fi
fi
mkdir -p /newroot
# busybox mount only sets up a loop for regular files; for a block device the loop options would
# be handed to ext4 (EINVAL), so attach the loop explicitly and verify its offset
# The ext4 area holds one or more systems: /ubuntu, /openwrt (selected by /.mu300/boot-os), or a single
# Ubuntu directly in its root (first installs). Pick one and remember how to start it.
has_init() { [ -x "$1/lib/systemd/systemd" ] || [ -x "$1/sbin/init" ]; }
pick_root() {
    want=$(cat /disk/.mu300/boot-os 2>/dev/null)
    for os in $want ubuntu openwrt; do
        [ -d "/disk/$os" ] && has_init "/disk/$os" && { echo "/disk/$os"; return; }
        # legacy layout: Ubuntu in the filesystem root
        [ "$os" = ubuntu ] && [ -x /disk/lib/systemd/systemd ] && { echo /disk; return; }
    done
}
mkdir -p /disk
rootloop=$(losetup -f 2>/run/rootmount.err)
# --- MU300/F50 local change (v3 / t13): mount the fulldumpdb partition itself; the upstream
# loop-device-with-offset path below stays as the fallback for devices that use the linux region.
rootok=0
if [ -n "$rootpart" ] && [ -b "$rootpart" ]; then
    rootloop=$rootpart
    if [ "$(dd if="$rootpart" bs=1 skip=1080 count=2 2>/dev/null | od -An -tx1 | tr -d ' ')" = 53ef ]; then
        if mount -t ext4 -o noatime "$rootpart" /disk 2>>/run/rootmount.err; then
            rootok=1
        elif [ -x /usr/sbin/fsck.ext4 ]; then
            # Same as the 5.4 init: a rootfs left dirty by an unclean shutdown refuses to mount --
            # repair it once and retry. (t11's trial rebooted every 5 minutes, so this is likely.)
            log "stage=rootfs-mount-failed (running e2fsck)"
            umount /disk 2>/dev/null
            sync
            /usr/sbin/fsck.ext4 -fy "$rootpart" >> /run/fsck.log 2>&1
            log "stage=fsck-done (log /run/fsck.log)"
            sync
            mount -t ext4 -o noatime "$rootpart" /disk 2>>/run/rootmount.err \
                && rootok=1 && log "stage=rootfs-mounted-after-fsck"
        else
            log "stage=rootfs-mount-failed (no fsck.ext4 in this ramdisk)"
        fi
    else
        log "stage=rootpart-not-ext4 magic=$(dd if="$rootpart" bs=1 skip=1080 count=2 2>/dev/null | od -An -tx1 | tr -d ' ')"
    fi
elif [ -n "$rootloop" ] && losetup -o $ROOT_OFFSET "$rootloop" /dev/mmcblk0 2>>/run/rootmount.err \
   && [ "$(cat /sys/block/${rootloop#/dev/}/loop/offset)" = "$ROOT_OFFSET" ] \
   && [ "$(dd if="$rootloop" bs=1 skip=1080 count=2 2>/dev/null | od -An -tx1 | tr -d ' ')" = 53ef ] \
   && mount -t ext4 -o noatime "$rootloop" /disk 2>>/run/rootmount.err; then
    rootok=1
fi

# === v8c8e:恢复 v7 工作版的关键一段 —— switch_root 之前的 sipa_dele 等待/重试/ACK 确认 ===
# v7(工作期)的 init 在这里做:等 rescue 通道起来 -> 每隔 10s 重试 insmod sipa-dele.ko ->
# 成功后(有界 60s)等 delegate 线程的 channel 5-120 ack 出现,并明确区分 ack / 打开失败 / 未确认。
# 我们 v8c5 重写时删掉了这段(改成早载 + 驱动侧重试);diff 显示这是 v7 与 v8c8d 在 modem_control 之前最大的差异。
# v7 原文注释:早载 insmod 会 probe 失败;而“成功但过早”更糟 —— sipa_dele 是 [permanent],
# 线程一旦在 channel 120 上打开失败就整个启动期都不会恢复。
SIPA_DELE_WAIT=${SIPA_DELE_WAIT:-150}
SIPA_DELE_ACK_WAIT=${SIPA_DELE_ACK_WAIT:-60}
sipa_dele_load() {
    [ -f /linux-modules/sipa-dele.ko ] || { log "stage=sipa-dele-not-bundled"; return 1; }
    grep -q '^sipa_dele ' /proc/modules && { log "stage=sipa-dele-already-loaded"; return 0; }
    # ack patterns: 6.18 prints "sipa_dele: <func>: channel 5-120!" and "sipa_dele: smsg_recv, smsg_cnt=...";
    # 5.4 printed "channel 5-120 send open msg" (kept so the same test builds against either tree).
    ack_pat='channel 5-120!|smsg_recv, smsg_cnt=|channel 5-120 send open msg'
    fail_pat='failed to open dst 5 channel 120'
    n=0
    while [ "$n" -lt "$SIPA_DELE_WAIT" ]; do
        if insmod /linux-modules/sipa-dele.ko 2>/run/sipa-dele.err; then
            # probe took. Now wait (bounded) for the delegate's channel 5-120 to come up - and say exactly
            # which of the three things happened. "no ack yet" is NOT "no delegate": the thread may still be
            # waiting, and sipa_dele is [permanent] so a wrong story here would mislead the next debugging.
            w=0
            while [ "$w" -lt "$SIPA_DELE_ACK_WAIT" ]; do
                if dmesg | grep -qE "$ack_pat"; then
                    log "stage=sipa-dele-loaded-ack after ${n}s (+$w s ack wait, channel 5-120 open ack: downlink path in place)"
                    return 0
                fi
                if dmesg | grep -q "$fail_pat"; then
                    log "stage=sipa-dele-loaded-delegate-failed after ${n}s (sipa_delegator failed to open dst 5 channel 120; permanent, cannot reload)"
                    return 1
                fi
                w=$((w + 5))
                sleep 5
            done
            log "stage=sipa-dele-loaded-delegate-unconfirmed after ${n}s (insmod ok, +${SIPA_DELE_ACK_WAIT}s with neither ack nor failure - unknown, not proven absent)"
            return 1
        fi
        [ "$n" = 0 ] && log "stage=sipa-dele-wait (first insmod failed, retrying every 10s up to ${SIPA_DELE_WAIT}s)"
        n=$((n + 10))
        sleep 10
        persist
    done
    log "stage=sipa-dele-failed after ${SIPA_DELE_WAIT}s ($(tail -1 /run/sipa-dele.err 2>/dev/null)) - continuing"
    return 1
}
# v8c10: 短路这一段 —— 时序实测:sipa_dele 11.17s 加载 vs CP 32.41s 起,
# 阶段机本身仍是“早载”,retry-stop 救不了早载失败。改由 rootfs 的
# /opt/mu300/bin/sipa-dele-start 在 CP 就绪(AT+CGATT?==1)后再加载;模块文件仍留在 ramdisk。
# sipa_dele_load                    # ← v8c10 起不跑(函数定义保留,便于回退/对照)

if [ "$rootok" = 1 ] && rootdir=$(pick_root) && [ -n "$rootdir" ]; then
    # A way back to Android with no computer and no keyboard: cut the power during boot N times in a row (N is
    # .mu300/boot-attempts, 5 without it). Every boot counts up here and mu300-next-boot --rearm clears the count
    # once the system is really up, so only boots that never got that far add up. LK does the same with the
    # tries it was armed with (N+1) and normally gets there first; this is the backstop, and it goes to Android
    # on the boot after the Nth failed one, exactly when LK would.
    # only in default-Linux mode: with the one-shot trial every power cut already lands in Android
    if [ "$(cat "$rootdir/etc/mu300/default-boot" 2>/dev/null)" = linux ]; then
        tries=$(cat /disk/.mu300/boot-tries 2>/dev/null || echo 0)
        case $tries in ''|*[!0-9]*) tries=0 ;; esac
        tries=$((tries + 1))
        mkdir -p /disk/.mu300 && echo "$tries" > /disk/.mu300/boot-tries && sync
    else
        tries=0
    fi
    max=$(cat /disk/.mu300/boot-attempts 2>/dev/null); case $max in [1-6]) ;; *) max=5 ;; esac
    if [ "$tries" -gt "$max" ]; then
        log "stage=boot-tries-exceeded count=$tries (booting Android instead)"
        echo 0 > /disk/.mu300/boot-tries && sync
        restore_slot_a
        persist
        sync
        reboot -f
        sleep 30
    fi

    if [ "$rootdir" = /disk ]; then
        mount --move /disk /newroot
    else
        mount --bind "$rootdir" /newroot
        # keep the whole disk reachable from inside (switching systems, editing the other one)
        mkdir -p /newroot/mnt/mu300-disk && mount --move /disk /newroot/mnt/mu300-disk
    fi
    # Default-Linux mode: leave LK's decremented tries (b: not successful). Userspace re-arms slot b (tries N+1)
    # once the system is up; N boots in a row that never get there and LK falls back to Android on the next one.
    if [ "$(cat /newroot/etc/mu300/default-boot 2>/dev/null)" = linux ]; then
        log "stage=default-boot-linux (slot a restore skipped)"
    else
        restore_slot_a
    fi
    mkdir -p /run/mu300 && cp /etc/misc-bc-slot-a.bin /etc/misc-bc-slot-b-trial.bin /run/mu300/
    [ -n "$misc" ] && echo "$misc" > /run/mu300/misc-dev
    echo "$rootloop" > /run/mu300/disk-dev
    echo "$DEVICE" > /run/mu300/device
    init=/sbin/init
    [ -x /newroot/lib/systemd/systemd ] && init=/lib/systemd/systemd
    log "stage=switch-root root=$rootdir init=$init os=$(sed -n 's/^PRETTY_NAME=//p' /newroot/etc/os-release)"
    persist
    kill $(jobs -p) 2>/dev/null
    for p in /proc/[0-9]*; do [ "${p#/proc/}" = 1 ] || kill -9 "${p#/proc/}" 2>/dev/null; done
    umount /config 2>/dev/null
    mkdir -p /newroot/dev /newroot/proc /newroot/sys /newroot/run
    # v8c8d: 让切换后的用户态一开始就拥有【完整】的 Android 属性区。
    # ramdisk 里的 /android/dev/__properties__ 只有 19 个文件(缺 vendor_radio_prop / vendor_modem_prop),
    # 而 modem_control 查 ro.vendor.radio.modemtype 是直接 mmap 上下文文件 ⇒ 会报 not_find。
    # rootfs 里那份是完整 334 个文件(与健康期备份逐字节相同),这里先 bind 到 /dev/__properties__,
    # 随后那句 mount --move /dev 会把子挂载一起带走,用户态/android-vendor-start 无需再管。
    if [ -s /newroot/opt/mu300/android/dev-properties/property_info ]; then
        mkdir -p /dev/__properties__
        if mount --bind /newroot/opt/mu300/android/dev-properties /dev/__properties__ 2>/dev/null; then
            log "stage=props-full-bind ok files=$(ls /dev/__properties__ 2>/dev/null | wc -l)"
        else
            log "stage=props-full-bind FAILED (falling back to ramdisk set)"
        fi
    else
        log "stage=props-full-bind skipped (no rootfs dev-properties)"
    fi
    mount --move /dev /newroot/dev
    mount --move /proc /newroot/proc
    mount --move /sys /newroot/sys
    mount --move /run /newroot/run 2>/dev/null
    exec switch_root /newroot $init
fi
log "stage=rootfs-unavailable $(cat /run/rootmount.err)"
restore_slot_a
ifconfig usb0 192.168.77.1 netmask 255.255.255.0 up
log "stage=usb0 $(ifconfig usb0 2>&1 | head -1)"
cat > /etc/udhcpd.conf <<'EOF'
start 192.168.77.2
end 192.168.77.9
interface usb0
option subnet 255.255.255.0
option lease 600
lease_file /run/udhcpd.leases
pidfile /run/udhcpd.pid
EOF
touch /run/udhcpd.leases
udhcpd /etc/udhcpd.conf
telnetd -b 192.168.77.1 -p 23 -l /bin/sh
mkdir -p /run/www
echo "MU300 standalone Linux v5: telnet 192.168.77.1; auto reboot to Android after 300s unless /run/stay exists" > /run/www/index.html
httpd -p 192.168.77.1:80 -h /run/www
log "stage=ready"

# Android vendor services in a chroot. modem_control reloads pm_sys through Trusty; only then
# can sprd_pmic_wdt send "watchdog rstoff" and stop the PM co-processor from cutting power.
A=/android
cp -a $A/dev/__properties__ /dev/__properties__
mkdir -p /dev/block/by-name
for u in /sys/class/block/mmcblk0p*/uevent; do
    d=$(basename "$(dirname "$u")")
    n=$(sed -n 's/^PARTNAME=//p' "$u")
    ln -sf /dev/$d /dev/block/$d
    [ -n "$n" ] && ln -sf /dev/$d /dev/block/by-name/$n
done
mkdir -p $A/dev $A/proc $A/sys $A/data/vendor $A/mnt $A/tmp
mount --bind /dev $A/dev
mount -t proc proc $A/proc
mount -t sysfs sysfs $A/sys
# modem_control switches to uid system(1000); apply Android's ueventd/init node ownership
sh /etc/ueventd-perms.sh
# LK boots us from slot b; the modem images Android uses (and keeps updated) are the _a copies
# the vendor daemons read androidboot.* (slot, modem config) from the command line; the mainline kernel forces its
# own command line, so fall back to the bootargs LK put in the device tree
src=/proc/cmdline
grep -q androidboot.slot_suffix /proc/cmdline || [ ! -r /proc/device-tree/chosen/bootargs ] || src=/proc/device-tree/chosen/bootargs
tr -d '\000' < $src | sed 's/androidboot.slot_suffix=_b/androidboot.slot_suffix=_a/' > /run/cmdline.android
mount --bind /run/cmdline.android $A/proc/cmdline
# liblog sends to logd's datagram socket; capture it so vendor daemons are debuggable
mkdir -p /dev/socket
/bin/logdw /dev/socket/logdw > /run/logcat.txt 2>&1 &
sleep 1
log "stage=android-chroot-ready nodes=$(ls /dev/modem /dev/pmsys /dev/sctl_pm /dev/trusty-ipc-dev0 2>&1 | tr '\n' ',')"
# exec the binary itself (interpreter /system/bin/linker64): sprd_modem_loader only accepts
# ioctls/writes from a task whose comm is exactly "modem_control"
LD_LIBRARY_PATH=/apex/com.android.runtime/lib64/bionic:/system/lib64:/vendor/lib64 \
    chroot $A /vendor/bin/modem_control > /run/modem_control.log 2>&1 &
log "stage=modem_control-started pid=$!"
(for n in $(seq 1 120); do
    if dmesg | grep -q "sbuf ready for pmic wdt init"; then log "stage=pmic-wdt-rstoff-ready t=$n"; exit 0; fi
    sleep 2
 done; log "stage=pmic-wdt-NOT-ready") &
while :; do
    dmesg > /run/www/dmesg.txt
    cat /proc/modules > /run/www/modules.txt
    sleep 5
done
