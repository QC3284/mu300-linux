#!/bin/busybox sh
# MU300 initramfs: 从 SD 卡恢复 Linux rootfs
# ★ 全部动态探测,没有写死的设备名/UUID/路径 ★
# 用法: sd-restore [-y] [镜像文件名]
PATH=/bin:/sbin:/usr/bin:/usr/sbin
DIRNAME=f50-backup
[ -n "$MU300_BACKUP_DIR" ] && DIRNAME=$MU300_BACKUP_DIR

echo "=== MU300 rescue: restore rootfs from SD ==="

# 1 rootfs 分区:按 PARTNAME 动态找
ROOTPART=
for u in /sys/class/block/mmcblk*p*/uevent; do
    grep -qx PARTNAME=fulldumpdb "$u" 2>/dev/null && ROOTPART=/dev/$(basename "$(dirname "$u")")
done
[ -n "$ROOTPART" ] || { echo "ERR: no PARTNAME=fulldumpdb partition"; exit 1; }
echo "rootfs partition: $ROOTPART ($(blockdev --getsize64 $ROOTPART 2>/dev/null) bytes)"

# 2 ★ 动态找 SD:遍历所有块设备,找能挂载且含备份目录的 ★
SD=/mnt/sd
mkdir -p $SD
umount $SD 2>/dev/null
FOUND=
for d in /dev/mmcblk*p* /dev/sd*; do
    [ -b "$d" ] || continue
    [ "$d" = "$ROOTPART" ] && continue
    PN=$(cat /sys/class/block/$(basename $d)/uevent 2>/dev/null | sed -n 's/^PARTNAME=//p')
    case "$PN" in misc|boot_a|boot_b|*dump*|*super*|*cache*|*metadata*) continue;; esac
    for t in exfat vfat ext4 ext2; do
        if mount -t "$t" -o ro "$d" $SD 2>/dev/null; then
            if [ -d "$SD/$DIRNAME" ]; then
                FOUND=$d
                echo "SD card: $d (mounted $t) OK"
                break
            fi
            umount $SD 2>/dev/null
        fi
    done
    [ -n "$FOUND" ] && break
done
if [ -z "$FOUND" ]; then
    echo "ERR: no SD card with a $DIRNAME directory found"
    echo "tried these block devices:"
    ls /dev/mmcblk*p* /dev/sd* 2>/dev/null | head -20 | sed 's/^/    /'
    exit 1
fi
BK=$SD/$DIRNAME

# 3 列可用镜像
echo
echo "* available images:"
ls -la $BK/*.img.gz 2>/dev/null | while read -r line; do echo "  $line"; done

# 4 参数
ASSUME_YES=0
case "$1" in
    -y|--yes) ASSUME_YES=1; shift ;;
esac
IMG="$1"
if [ -z "$IMG" ]; then
    echo
    echo "usage: sd-restore [-y] <image-filename>"
    echo "       -y  skip the confirmation (safe to run in background)"
    exit 0
fi
SRC=$BK/$IMG
[ -f "$SRC" ] || { echo "ERR: $SRC not found"; exit 1; }

# 5 前置检查
echo
echo "  target : $ROOTPART ($(blockdev --getsize64 $ROOTPART 2>/dev/null) bytes)"
echo "  image  : $SRC"
echo "  packed : $(wc -c < "$SRC") bytes"
echo
echo "*** about to write $IMG to $ROOTPART ***"
echo "    this fully overwrites the current rootfs!"
if [ "$ASSUME_YES" = "1" ]; then
    echo "    (-y given, skipping confirmation)"
else
    printf "    confirm? type yes: "
    read a
    [ "$a" = "yes" ] || { echo "cancelled"; exit 0; }
fi

# 6 写入
echo "writing..."
umount /disk 2>/dev/null
sync
gzip -dc "$SRC" | dd of="$ROOTPART" bs=4M 2>&1 | tail -2
sync
echo "  (dd done)"

# 7 必须 fsck
echo
echo "checking/repairing filesystem (required):"
/usr/sbin/fsck.ext4 -fy "$ROOTPART" 2>&1 | tail -8
sync

# 8 验证
echo
MAGIC=$(dd if="$ROOTPART" bs=1 skip=1080 count=2 2>/dev/null | hexdump -C | head -1 | awk '{print $2$3}')
echo "  magic (expect 53ef): $MAGIC"
if [ "$MAGIC" = "53ef" ]; then
    echo "*** done! run: reboot ***"
else
    echo "ERR: magic is $MAGIC - restore may have failed"
    exit 1
fi
