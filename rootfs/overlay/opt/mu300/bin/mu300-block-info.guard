#!/bin/sh
# mu300-block-info.guard [info|detect ...] -- /sbin/block with a deadline.
#
# /sbin/block can block in sbuf_read (sipc_core) when a block event races the probe; rpcd is single threaded, so every
# later ubus call (and every LuCI page) queues behind it. The deadline turns that into a failed probe instead.
set -u
DEADLINE=${MU300_BLOCK_GUARD_SECONDS:-8}
T=/opt/mu300/busybox-bin/timeout
[ $# -gt 0 ] || set -- info
if [ -x "$T" ]; then
    exec "$T" "$DEADLINE" /sbin/block "$@" 2>/dev/null
fi
exec /sbin/block "$@" 2>/dev/null
