#!/bin/sh /etc/rc.common
# Unisoc's RA renewal: the carrier sends Router Advertisements with short
# lifetimes, and the kernel stops treating prefixes/RDNSS as valid when they
# expire even if the link is still up. This daemon sends a Router Solicitation
# before each learned lifetime runs out, as the author's firmware does from
# /usr/sbin/unisoc-ra-renew (which is python3 there). Ours is the same protocol
# in ucode because this image carries no python runtime; it is additive only:
# it never synthesises an RA, writes no route, sends no AT command and touches
# no netlink state, so a kernel/odhcpd that solves this differently is unaffected.
START=98
STOP=10
USE_PROCD=1
start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/ucode /usr/sbin/unisoc-ra-renew
    procd_set_param respawn 3600 10 5
    procd_set_param nice 10
    procd_set_param stderr 1
    procd_close_instance
}