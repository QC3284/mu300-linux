#!/bin/sh /etc/rc.common
# Keep the per-SIM registration cache (/run/mu300-registration/*) current: the panel reads
# it for info.modem.sims, exactly as on the author firmware. Started after mu300-atd (S19),
# before the panel and the SMS daemon (S95); a missing reader is not fatal.
START=94
USE_PROCD=1

start_service() {
    [ -c /dev/stty_nr1 ] || return 0
    procd_open_instance
    procd_set_param command /opt/mu300/bin/mu300-registration
    procd_set_param respawn 3600 5 0
    procd_set_param nice 10
    procd_set_param stderr 1
    procd_close_instance
}
