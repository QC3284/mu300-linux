[Unit]
Description=MU300 join the saved Wi-Fi network (station mode; stops the hotspot while connected)
ConditionPathExists=/etc/mu300/wifi-client.conf
After=mu300-wifi.service
Wants=mu300-wifi.service
Before=mu300-hotspot.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/mu300/bin/wifi-client up
ExecStop=/opt/mu300/bin/wifi-client disconnect

[Install]
WantedBy=multi-user.target
