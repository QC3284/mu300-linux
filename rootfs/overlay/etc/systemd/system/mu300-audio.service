[Unit]
Description=MU300 Unisoc sound card (sprdphone-sc2730)
# The card needs its drivers, the DMA engine and a hand-written bind; extra-modules has run by then.
After=mu300-extra-modules.service
ConditionPathIsDirectory=/lib/modules/%v/audio

[Service]
Type=oneshot
RemainAfterExit=yes
# "load" only. "start" writes the DSP firmware and reboots the device - see the warning in the script.
ExecStart=/opt/mu300/bin/mu300-audio-dsp load
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
