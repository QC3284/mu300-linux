#!/bin/sh
# The feed default is AU; this device ships for TR. Only fills a missing value, never overrides a choice.
for r in $(uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
    [ -n "$(uci -q get "wireless.$r.country")" ] || uci -q set "wireless.$r.country=TR"
done
uci -q commit wireless 2>/dev/null || true
exit 0
