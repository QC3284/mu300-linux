#!/bin/sh
# The feed default is AU and this device keeps it; only a missing value is filled, a choice is never overridden.
for r in $(uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
    # The default only fills a missing value, so a device that ran an older image keeps TR forever. Migrate it once: an
    # explicit TR from the user is rare enough, and AU is the country the feed runs in.
    _c=$(uci -q get "wireless.$r.country")
    if [ -z "$_c" ] || [ "$_c" = TR ]; then uci -q set "wireless.$r.country=AU"; fi   # migration
done
uci -q commit wireless 2>/dev/null || true
exit 0
