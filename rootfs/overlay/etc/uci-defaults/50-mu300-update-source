#!/bin/sh
# Fresh installs point the updater at the fork that built this image. An existing file is the user's own choice and is
# left alone, so re-running after an update changes nothing.
[ -s /etc/mu300/update-source ] && exit 0
( umask 077
  cat > /etc/mu300/update-source <<'SRC'
# Release source of this image: the fork that builds it (fresh installs offer its releases).
# A file here is the whole setting; delete it to fall back to the project's own repository.
MU300_API_URL=https://api.github.com/repos/QC3284/mu300-linux
MU300_API_MIRROR=https://gh-proxy.com/https://api.github.com
MU300_DOWNLOAD_URL=https://github.com/QC3284/mu300-linux/releases/download
SRC
  chmod 600 /etc/mu300/update-source ) 2>/dev/null || true
exit 0
