#!/bin/sh

. /etc/openwrt_release

CPUINFO_PATH="/proc/cpuinfo"
CPUFREQ_PATH="/sys/devices/system/cpu/cpufreq"
THERMAL_PATH="/sys/class/thermal"

cpu_arch="$(awk -F ': ' '/model name/ {print $2}' "$CPUINFO_PATH" | head -n1)"
if [ -n "$cpu_arch" ]; then
	cpu_cores="x $(grep -c '^processor' "$CPUINFO_PATH")"
else
	# arm64 (user-picked format, 2026-10-31): "UMS9620 (T760) · 4×A55 + 4×A76" — chip name + core counts, no freq/temp
	cpu_arch="$(awk '
		/^CPU part/ {
			gsub(/[ 	]/, "", $0)
			split($0, a, ":")
			p = a[2]
			if (p == "0xd0b") n = "A76"
			else if (p == "0xd05") n = "A55"
			else if (p == "0xd0d") n = "A77"
			else if (p == "0xd46") n = "A510"
			else if (p == "0xd47") n = "A715"
			else if (p == "0xd48") n = "A720"
			else n = (p ~ /^0x/ ? p : "0x" p)
			cnt[n]++
		}
		END {
			s = ""
			if (cnt["A55"]) s = s cnt["A55"] "×A55"
			if (cnt["A76"]) s = s (s ? " + " : "") cnt["A76"] "×A76"
			if (cnt["A77"]) s = s (s ? " + " : "") cnt["A77"] "×A77"
			if (cnt["A510"]) s = s (s ? " + " : "") cnt["A510"] "×A510"
			if (cnt["A715"]) s = s (s ? " + " : "") cnt["A715"] "×A715"
			if (cnt["A720"]) s = s (s ? " + " : "") cnt["A720"] "×A720"
			for (n in cnt)
				if (n !~ /^A/) s = s (s ? " + " : "") cnt[n] "×" n
			print "UMS9620 (T760) · " (s ? s : "?")
		}' "$CPUINFO_PATH")"
	cpu_cores=""
	is_arm=1
fi

case "$DISTRIB_TARGET" in
"x86"/*)
	cpu_freq="$(awk -F ': ' '/MHz/ {print $2}' "$CPUINFO_PATH" | head -n1)MHz" ;;
"rockchip"/*)
	cpu_freq="$(awk '{printf("%.fMHz ", $0 / 1000)}' "$CPUFREQ_PATH"/policy*/cpuinfo_cur_freq | awk '$1=$1')" ;;
*)
	[ ! -e "$CPUFREQ_PATH/policy0/cpuinfo_cur_freq" ] || \
		cpu_freq="$(awk '{printf("%.fMHz", $0 / 1000)}' "$CPUFREQ_PATH/policy0/cpuinfo_cur_freq")"
	;;
esac

case "$DISTRIB_TARGET" in
"bcm27xx"/*)
	cpu_temp="$(vcgencmd measure_temp | awk -F '=' '{print $2}' | awk -F "'" '{print $1}')°C" ;;
"x86"/*)
	if [ -n "$(uci -q get "wechatpush.config.server_host")" ]; then
		cpu_temp="$(/usr/share/wechatpush/wechatpush soc)°C"
	elif grep -q "GenuineIntel" "/proc/cpuinfo"; then
		cpu_temp="$(sensors "coretemp-*" 2>"/dev/null" | grep -E "(Package id |Core )" | grep -Eo "\+[0-9.]*°C" | head -n1 | tr -d "+")"
	elif grep -q "AuthenticAMD" "/proc/cpuinfo"; then
		cpu_temp="$(sensors "k10temp-*" 2>"/dev/null" | awk '/Tctl|Tdie/ {print $2}' | head -n1 | tr -d "+")"
	fi
	;;
*)
	[ ! -e "$THERMAL_PATH/thermal_zone0/temp" ] || \
		cpu_temp="$(awk '{printf("%.1f°C", $0 / 1000)}' "$THERMAL_PATH/thermal_zone0/temp")"
	;;
esac

details=""
[ -z "$cpu_freq" ] || details="$details$cpu_freq"
if [ -n "$cpu_temp" ]; then
	[ -z "$details" ] || details="$details, "
	details="$details$cpu_temp"
fi

out="$cpu_arch"
if [ -z "$is_arm" ]; then
	[ -z "$cpu_cores" ] || out="$out $cpu_cores"
	[ -z "$details" ] || out="$out ($details)"
fi
echo -n "$out"

exit 0
