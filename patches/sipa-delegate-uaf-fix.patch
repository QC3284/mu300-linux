@@ -176,15 +176,21 @@
 	sipa_delegator_start(&s_cp_delegator->delegator);
 	pm_runtime_enable(s_cp_delegator->delegator.pdev);
 
+	/* MU300: the Wi-Fi data-path dependencies are optional here. Failing the
+	 * probe after sipa_delegator_start() leaves the delegator kthread running
+	 * in memory devm is about to free (probe != 0 -> devm_kzalloc is released),
