+	 * Warn and carry on instead.
+	 */
 	ret = sipa_rm_add_dependency(SIPA_RM_RES_CONS_WIFI_UL,
 				     s_cp_delegator->delegator.prod_id);
 	if (ret)
-		return ret;
+		dev_warn(params->pdev, "add_dependency WIFI_UL failed: %d (continuing)\n", ret);
 
 	ret = sipa_rm_add_dependency(SIPA_RM_RES_CONS_WIFI_DL,
 				     s_cp_delegator->delegator.prod_id);
 	if (ret)
-		return ret;
+		dev_warn(params->pdev, "add_dependency WIFI_DL failed: %d (continuing)\n", ret);
 
 	sipa_dele_init_sysfs(s_cp_delegator);
 
