# --- thermal: on-die sensors with eFuse calibration (read-only nvmem)
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_CPU_THERMAL=y
CONFIG_NVMEM=y
CONFIG_NVMEM_SPRD_EFUSE=y
CONFIG_HWSPINLOCK_SPRD=y
CONFIG_SPRD_THERMAL_R5P0=y

# --- cpufreq (ATF DVFS via SIP calls) and PSCI cpuidle
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_ENERGY_MODEL=y
CONFIG_SPRD_SIP_SVC=y
CONFIG_ARM_SPRD_CPUFREQ_V2=y
CONFIG_CPU_IDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y

# --- PMIC LEDs (status LEDs)
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=m
CONFIG_LEDS_SC27XX_BLTC=m
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_NETDEV=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y

# --- PCIe RC (Marlin3 Wi-Fi/BT) and loadable modules for the out-of-tree WCN drivers
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIE_SPRD=y

# --- Bluetooth (Marlin3 H4 over sprdbt_tty)
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y
CONFIG_CRYPTO_ECDH=m
CONFIG_CRYPTO_AES=m
CONFIG_CRYPTO_CMAC=m

# --- modem stack (out-of-tree): Trusty IPC runs over virtio queues
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_DMABUF_HEAPS=y
CONFIG_MAILBOX=y

# --- PMIC RTC
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_SC27XX=y

# GPU: explicit fences (the DDK's fence helpers and Android's GPU userspace both need them)
CONFIG_SYNC_FILE=y

# GPU: the Mali DDK's devfreq support (frequency scaling and the vendor's frequency statistics)
CONFIG_PM_DEVFREQ=y
CONFIG_PM_DEVFREQ_EVENT=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=m
CONFIG_DEVFREQ_GOV_PERFORMANCE=m
CONFIG_DEVFREQ_GOV_POWERSAVE=m
CONFIG_DEVFREQ_GOV_USERSPACE=m
CONFIG_DEVFREQ_THERMAL=y
# boot logo buffer (no display) and bootloader sysdump area back to Linux: +25 MiB (patches/0003)
CONFIG_OF_RESERVED_MEM_SKIP="logobuffer,sysdump-uboot"
# hangs become panics (and a panic reaches ramoops): without these detectors the softlockup_panic and
# hardlockup_panic that boot/init sets had nothing behind them, and a hang left no trace at all. The panic
# switches are on the command line (BOOTPARAM_SOFTLOCKUP_PANIC is a bool in 6.x and a number in 7.x)
CONFIG_DEBUG_KERNEL=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
# reported, not fatal: vendor threads sleep uninterruptibly for good (sipa-set-rps, slog, the Wi-Fi TX thread)
CONFIG_DETECT_HUNG_TASK=y

# ── t14 P0:功能平价 ────────────────────────────────────────────────────────────────────────────
# The vendor 5.4 image carries 11 hand-built modules (kmods/README.md) for functions the vendor
# kernel did not build. On mainline they are built as modules from the same kernel, so the same
# functions are available without hand-patching a config later. All of them are =m (like OpenWrt's
# kmod packages) so they can be shipped and loaded on demand.
# PPPoE (the vendor side is a hand-built pppoe.ko; CONFIG_PPP itself is already =y above)
CONFIG_PPPOE=m
# SQM queueing disciplines (kmods: sch_netem/sch_sfb/sch_drr/sch_qfq/sch_hhf/sch_pie; cake and
# fq_codel are already =y, so SQM works either way - these widen the menu)
CONFIG_NET_SCH_NETEM=m
CONFIG_NET_SCH_SFB=m
CONFIG_NET_SCH_DRR=m
CONFIG_NET_SCH_QFQ=m
CONFIG_NET_SCH_HHF=m
CONFIG_NET_SCH_PIE=m
# traffic classification (kmods: cls_flower.ko)
CONFIG_NET_CLS_FLOWER=m
# nlbwmon accounting (kmods: nfnetlink_acct.ko) - selects NETFILTER_NETLINK itself
CONFIG_NETFILTER_NETLINK_ACCT=m
# containers / virtualisation (kmods: nbd.ko, vhost_net.ko)
CONFIG_BLK_DEV_NBD=m
# VHOST_NET lives under a menuconfig that allnoconfig turns off; without this line "VHOST_NET=m"
# does not take and build.sh stops with "NOT SET" (it checks every option in this file).
CONFIG_VHOST_MENU=y
CONFIG_VHOST_NET=m

# ── t16 v6:LED pattern trigger ─────────────────────────────────────────────────────────────────
# The status LEDs are the SC27xx breathing-light controller (CONFIG_LEDS_SC27XX_BLTC=y above, and the
# vendor 5.4 config had it as a module). Its driver exposes the LED "pattern" interface, and the
# rootfs' /opt/mu300/bin/mu300-led.sh drives the boot chase colours through it. The vendor 5.4 kernel
# shipped ledtrig-pattern.ko; ours did not, so those writes went nowhere and the LEDs looked dead.
# (=y, not =m: it is a handful of bytes and the LED helper runs before anything could load a module.)
CONFIG_LEDS_TRIGGER_PATTERN=y
